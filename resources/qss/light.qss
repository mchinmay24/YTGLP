QMainWindow { background-color:#f5f5f5; color:#111111; }
QLabel { color:#000000; }
QLineEdit, QComboBox, QProgressBar, QFrame { background-color:#ffffff; color:#000000; }
QPushButton { background-color:#dddddd; color:#000000; border-radius:4px; padding:6px 10px; }
QPushButton:hover { background-color:#cccccc; }
