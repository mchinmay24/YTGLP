QMainWindow { background-color:#121212; color:#121212; }
QLabel { background-color: transparent; color:#eeeeee; }
QLineEdit, QComboBox, QProgressBar, QFrame, QMessageBox, QFileDialog { background-color:#1e1e1e; color:#ffffff; }
QPushButton { background-color:#333333; color:#ffffff; border-radius:4px; padding:6px 10px; }
QPushButton:hover { background-color:#444444; }
QCheckBox::indicator {
    width: 3px;
    height: 8px;
    border: 1px solid #888;
    border-radius: 3px;
    background-color: #888;
}

QCheckBox::indicator:checked {
    background-color: #2bff00;
    border-color: #2bff00;
}

QCheckBox {
    spacing: 6px;
    color:#ffffff;
}
QHBoxLayout{
    margin: 10px;
}
QSpinBox{
    background-color: transparent;
    color: #ffffff;
    border: 1px solid white;
    border-radius: 25px;
    width: 10px;
}